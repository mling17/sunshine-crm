[Unit]
Description=CRM V1 每日备份（SQLite 快照 + 照片打包 + 异机上传）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/opt/data/crm/ops/backup.env
ExecStart=/usr/bin/python3 /opt/data/crm/ops/backup.py
# 备份卡死比不备份更糟：15 分钟没完就掐掉，本次标记失败等告警
TimeoutStartSec=900
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crm-backup
