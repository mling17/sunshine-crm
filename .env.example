# 复制成 .env 后填真值（.env 已在 .gitignore 中，不会入库）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Docker Compose 配置
CRM_IMAGE=sunshine-crm:latest
CRM_BIND_ADDRESS=0.0.0.0
CRM_PORT=8010
TZ=Asia/Shanghai
COOKIE_SECURE=0

# 可选：异地备份（MinIO），口令只放 ops/backup.env
# CRM_MINIO_ENDPOINT=host:9000
# CRM_MINIO_BUCKET=crm-backups
# CRM_MINIO_ACCESS=
# CRM_MINIO_SECRET=
