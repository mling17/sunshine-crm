# 复制成 .env 后填真值（.env 已在 .gitignore 中，不会入库）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Docker Compose 配置
CRM_IMAGE=sunshine-crm:latest
CRM_BIND_ADDRESS=0.0.0.0
CRM_PORT=8010
TZ=Asia/Shanghai
COOKIE_SECURE=0

# 数据库：默认 sqlite；切换 MySQL 时改成 mysql
CRM_DB_ENGINE=sqlite
CRM_MYSQL_HOST=mysql
CRM_MYSQL_PORT=3306
CRM_MYSQL_USER=crm
CRM_MYSQL_PASSWORD=
CRM_MYSQL_DATABASE=sunshine_crm
CRM_MYSQL_CHARSET=utf8mb4
# Compose 内网默认关闭 TLS；跨网/公网 MySQL 必须启用 TLS
CRM_MYSQL_SSL_DISABLED=true

# 仅使用 Compose 内置 MySQL（--profile mysql）时需要
MYSQL_ROOT_PASSWORD=

# 可选：异地备份（MinIO），口令只放 ops/backup.env
# CRM_MINIO_ENDPOINT=host:9000
# CRM_MINIO_BUCKET=crm-backups
# CRM_MINIO_ACCESS=
# CRM_MINIO_SECRET=
